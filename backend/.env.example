NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tinder_ad_software?schema=public"

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_COMMAND_ABOVE_TO_GENERATE
JWT_EXPIRATION=7d

# File Upload (local storage is used only when Cloudinary is not configured)
UPLOAD_DIR=./uploads
# Bytes per file. Default 100MB
MAX_FILE_SIZE=104857600

# Initial admin created by `npm run db:seed` / `npm run db:seed:prod`
# (required in production, min 8 chars; dev defaults to admin123)
ADMIN_EMAIL=admin@adverse.com
ADMIN_PASSWORD=

# Set to 1 when running behind one reverse proxy (Railway, nginx) so rate
# limiting sees the real client IP. Leave unset when exposed directly.
TRUST_PROXY=

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_ENABLED=true

# Frontend URL (for notification links)
FRONTEND_URL=http://localhost:5173

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
