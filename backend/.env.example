NODE_ENV=development
PORT=3000

# Database (docker compose up -d postgres creates the "ad_review" database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ad_review?schema=public"

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_COMMAND_ABOVE_TO_GENERATE
JWT_EXPIRATION=7d

# Seed (npm run db:seed) — cria o admin da plataforma (verificado, nunca cobrado)
SEED_ADMIN_EMAIL=admin@adverse.com
SEED_ADMIN_PASSWORD=

# File Upload (local disk is used only when Cloudinary is not configured)
UPLOAD_DIR=./uploads
# Bytes per file. Default 100MB (Cloudinary free plan video limit)
MAX_FILE_SIZE=104857600

# Frontend URL (CORS, links in e-mails/notifications, Stripe redirects)
FRONTEND_URL=http://localhost:5173

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_ENABLED=true

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- SaaS (self-signup, trial, billing). Optional in development, required in production ----

# Google Sign-In (same client ID goes in frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Resend (transactional e-mail: confirmação, boas-vindas, redefinição de senha, cobrança)
# Without a key, e-mails are only logged to the console (links included)
RESEND_API_KEY=
EMAIL_FROM=AdReviewOS <noreply@seudominio.com>

# Stripe (assinatura mensal). Webhook URL: https://sua-api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Trial period granted at signup (days)
TRIAL_PERIOD_DAYS=30
