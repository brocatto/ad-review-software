NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tinder_ad_software?schema=public"

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_COMMAND_ABOVE_TO_GENERATE
JWT_EXPIRATION=7d

# Seed (npm run db:seed) — cria o usuário admin inicial
SEED_ADMIN_EMAIL=admin@adverse.com
SEED_ADMIN_PASSWORD=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_ENABLED=true

# Frontend URL (for notification links)
FRONTEND_URL=http://localhost:5173

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
