# Produção (Railway). Copie para backend/.env.production, preencha e rode:
#   scripts/railway-env.sh backend/.env.production
# Nunca commite o arquivo preenchido (ele está no .gitignore).

NODE_ENV=production
PORT=3000

# Railway preenche DATABASE_URL automaticamente ao adicionar o PostgreSQL ao projeto.
# Se usar outro banco, defina aqui:
# DATABASE_URL=postgresql://user:pass@host:5432/adreviewos?schema=public

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=7d

# Admin da plataforma (criado por: railway run npm run db:seed)
SEED_ADMIN_EMAIL=admin@adverse.com
SEED_ADMIN_PASSWORD=

# Frontend publicado (CORS, links em e-mails, redirects do Stripe)
FRONTEND_URL=https://adreviewos.com

# Uploads: obrigatório em produção (disco do Railway é efêmero)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=104857600

# Login com Google (mesmo id usado no frontend em VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# E-mails (Resend, domínio news.adreviewos.com já verificado)
RESEND_API_KEY=
EMAIL_FROM=AdReviewOS <noreply@news.adreviewos.com>

# Stripe LIVE (saída de: STRIPE_SECRET_KEY=sk_live_... API_URL=https://api.adreviewos.com node backend/scripts/stripe-setup.mjs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PORTAL_CONFIGURATION_ID=   # só se o script indicar
TRIAL_PERIOD_DAYS=30

# Slack (opcional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Monitoramento (opcional, recomendado): projeto Node no sentry.io
SENTRY_DSN=
APP_VERSION=1.0.0
