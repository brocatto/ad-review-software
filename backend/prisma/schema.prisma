generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("MANAGER")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Auth providers: LOCAL (e-mail + senha) or GOOGLE (login social)
  googleId     String? @unique @map("google_id")
  authProvider String  @default("LOCAL") @map("auth_provider")

  // E-mail verification (self-signup accounts must confirm before logging in)
  emailVerified            Boolean   @default(false) @map("email_verified")
  verificationToken        String?   @map("verification_token")
  verificationTokenExpires DateTime? @map("verification_token_expires")

  // Password reset
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  // Billing: NONE | TRIAL | ACTIVE | PAST_DUE | CANCELED (mirrors Stripe via webhooks)
  stripeCustomerId   String?   @unique @map("stripe_customer_id")
  trialEndsAt        DateTime? @map("trial_ends_at")
  subscriptionStatus String    @default("NONE") @map("subscription_status")

  batches          Batch[]
  clients          Client[]
  adjustmentStatus InternalAdjustmentStatus[]
  activityLogs     ActivityLog[]
  creativeVersions CreativeVersion[]
  subscription     Subscription?

  @@index([verificationToken])
  @@index([resetToken])
  @@map("users")
}

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique
  displayName   String   @map("display_name")
  priceMonthly  Int      @map("price_monthly")
  stripePriceId String   @unique @map("stripe_price_id")
  features      String?
  limits        String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  planId               String    @map("plan_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String    @default("ACTIVE")
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model Client {
  id            String   @id @default(uuid())
  name          String
  email         String?
  company       String?
  contactPerson String?  @map("contact_person")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@index([userId])
  @@map("clients")
}

model Batch {
  id                String    @id @default(uuid())
  name              String
  clientId          String    @map("client_id")
  createdByUserId   String    @map("created_by_user_id")
  status            String    @default("PENDING")
  accessToken       String    @unique @map("access_token")
  totalCreatives    Int       @default(0) @map("total_creatives")
  approvedCount     Int       @default(0) @map("approved_count")
  rejectedCount     Int       @default(0) @map("rejected_count")
  pendingCount      Int       @default(0) @map("pending_count")
  lastInteractionAt DateTime? @map("last_interaction_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdByUserId], references: [id])
  creatives    Creative[]
  activityLogs ActivityLog[]

  @@index([clientId])
  @@index([accessToken])
  @@map("batches")
}

model Creative {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  name           String
  fileUrl        String   @map("file_url")
  fileType       String   @map("file_type")
  order          Int      @default(0)
  currentVersion Int      @default(1) @map("current_version")
  revisionCount  Int      @default(0) @map("revision_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  batch            Batch                     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  approval         Approval?
  adjustmentStatus InternalAdjustmentStatus?
  activityLogs     ActivityLog[]
  versions         CreativeVersion[]

  @@index([batchId])
  @@map("creatives")
}

model CreativeVersion {
  id               String   @id @default(uuid())
  creativeId       String   @map("creative_id")
  version          Int
  fileUrl          String   @map("file_url")
  fileType         String   @map("file_type")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  creative   Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedByUserId], references: [id])

  @@unique([creativeId, version])
  @@index([creativeId])
  @@map("creative_versions")
}

model Approval {
  id                 String    @id @default(uuid())
  creativeId         String    @unique @map("creative_id")
  status             String    @default("PENDING")
  feedbackText       String?   @map("feedback_text")
  feedbackProvidedAt DateTime? @map("feedback_provided_at")
  reviewedVersion    Int       @default(1) @map("reviewed_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

model InternalAdjustmentStatus {
  id              String   @id @default(uuid())
  creativeId      String   @unique @map("creative_id")
  status          String   @default("NOT_STARTED")
  notes           String?
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creative  Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedByUserId], references: [id])

  @@map("internal_adjustment_status")
}

model ActivityLog {
  id         String   @id @default(uuid())
  batchId    String?  @map("batch_id")
  creativeId String?  @map("creative_id")
  userId     String?  @map("user_id")
  action     String
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  batch    Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([creativeId])
  @@map("activity_logs")
}
